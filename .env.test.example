# Copy to .env.test. Use a SEPARATE database so tests never touch dev data.
NODE_ENV=test
PORT=4001
DATABASE_URL=postgres://postgres:12345678@localhost:5432/field-health-survey-test
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=test-secret-test-secret-test-secret-1234
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
